{
  "name": "broadcast",
  "private": true,
  "workspaces": [
    "web",
    "functions"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w functions",
    "typecheck": "npm run typecheck -w web && npm run build -w functions",
    "deploy": "npm run build && firebase deploy --only firestore,functions,hosting",
    "deploy:free": "npm run build && firebase deploy --only firestore,hosting",
    "emulators": "firebase emulators:start --project demo-broadcast --only auth,firestore,functions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"web/src/**/*.{ts,tsx}\" \"functions/src/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.31.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "typescript": "5.8.3"
  }
}
